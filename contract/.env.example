# copy to .env and fill in. NEVER commit the real .env.
PRIVATE_KEY=0xyourdeployerkey
ROYALTY_RECEIVER=0xyourTeamMultisig
HIDDEN_URI=ipfs://REPLACE_WITH_HIDDEN_CID/hidden.json

# ── launch chain: Robinhood Chain (EVM L2, gas paid in ETH) ──
#   mainnet  chain id 4663   explorer https://robinhoodchain.blockscout.com
#   testnet  chain id 46630  explorer https://explorer.testnet.chain.robinhood.com
# The public RPCs below are shared + rate limited. For mint day, put a dedicated
# endpoint here (chainstack / quicknode / dwellir) — same variable, no code change.
# ⚠️ MyRepublic (ID) DNS-blocks *.robinhood.com — every host resolves to
# block.myrepublic.co.id / 158.140.186.3. The endpoints themselves are fine
# (verified: they answer 0x1237 / 0xb626 when resolved correctly), it is purely DNS.
# Fixes, cheapest first:
#   1. set the Mac's DNS to 1.1.1.1 / 8.8.8.8, or
#   2. sudo sh -c 'printf "104.20.46.209 rpc.mainnet.chain.robinhood.com\n104.20.46.209 rpc.testnet.chain.robinhood.com\n" >> /etc/hosts'
#   3. or just use the mirror below for mainnet (no DNS block, verified chain id 4663)
# Must accept origin-less requests AND support the full method set. Measured
# 2026-08-18, because picking wrong here fails halfway through a mainnet deploy:
#   official endpoint      full methods, but DNS-blocked by some ISPs  <- use via proxy
#   Alchemy (frontend key) rejects forge/cast: no Origin header
#   robinhood.drpc.org     free tier answers ONLY eth_chainId
#   rpc.arrowrpc.com       down at time of writing (Cloudflare 1033)
# Simplest working setup: python3 scripts/rh_rpc_proxy.py --net mainnet --port 8547
ROBINHOOD_RPC_URL=http://127.0.0.1:8547
# ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com   # if your DNS is clean
# A second, UNRESTRICTED Alchemy key would also work here (keep the origin-locked
# one for the website and use the unrestricted one only for deploys).
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# ── other chains (kept for reference / fallback) ──
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
MAINNET_RPC_URL=https://eth.llamarpc.com
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# block explorer verification
# Robinhood Chain runs Blockscout and needs no key — these are for the L1 fallbacks.
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=
